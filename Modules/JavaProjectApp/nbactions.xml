<?xml version="1.0" encoding="UTF-8"?>
<actions>
    <action>
        <actionName>run</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>process-classes</goal>
            <goal>org.codehaus.mojo:exec-maven-plugin:3.5.0:java</goal>
        </goals>
        <properties>
            <exec.mainClass>hr.algebra.Main</exec.mainClass>
            <exec.workingdir>${project.basedir}/../..</exec.workingdir>
        </properties>
    </action>
    <action>
        <actionName>debug</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>process-classes</goal>
            <goal>org.codehaus.mojo:exec-maven-plugin:3.5.0:java</goal>
        </goals>
        <properties>
            <exec.mainClass>hr.algebra.Main</exec.mainClass>
            <exec.workingdir>${project.basedir}/../..</exec.workingdir>
            <jpda.listen>true</jpda.listen>
        </properties>
    </action>
    <action>
        <actionName>run.single</actionName>
        <packagings>
            <packaging>*</packaging>
        </packagings>
        <goals>
            <goal>process-test-classes</goal>
            <goal>org.codehaus.mojo:exec-maven-plugin:3.5.0:java</goal>
        </goals>
        <properties>
            <exec.mainClass>${packageClassName}</exec.mainClass>
            <exec.workingdir>${project.basedir}/../..</exec.workingdir>
        </properties>
    </action>
    <action>
        <actionName>debug.single</actionName>
        <packagings>
            <packaging>*</packaging>
        </packagings>
        <goals>
            <goal>process-test-classes</goal>
            <goal>org.codehaus.mojo:exec-maven-plugin:3.5.0:java</goal>
        </goals>
        <properties>
            <exec.mainClass>${packageClassName}</exec.mainClass>
            <exec.workingdir>${project.basedir}/../..</exec.workingdir>
            <jpda.listen>true</jpda.listen>
        </properties>
    </action>
</actions>
